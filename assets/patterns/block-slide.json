  "__file": "wp_block",
  "title": "Block Slide",
  "content": "<!-- wp:columns {\"metadata\":{\"name\":\"Block Slide\",\"categories\":[46]},\"className\":\"slide\"} -->\n<div class=\"wp-block-columns slide\"><!-- wp:column {\"lock\":{\"move\":true,\"remove\":true},\"metadata\":{\"name\":\"Column slide__figure\"},\"className\":\"slide__figure\",\"allowedBlocks\":[\"core/image\",\"core/gallery\",\"core/video\"]} -->\n<div class=\"wp-block-column slide__figure\"><!-- wp:image {\"lightbox\":{\"enabled\":true},\"sizeSlug\":\"large\",\"linkDestination\":\"none\",\"metadata\":{\"name\":\"Image slide__media\"},\"className\":\"slide__media\"} -->\n<figure class=\"wp-block-image size-large slide__media\"><img src=\"https://placehold.co/1024x1280\" alt=\"Portrait 4:5 / Recommended / 2048 x 2560\"/><figcaption class=\"wp-element-caption\">Lorem ipsum dolor sit amet</figcaption></figure>\n<!-- /wp:image --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"lock\":{\"move\":true,\"remove\":true},\"metadata\":{\"name\":\"Column slide__body\"},\"className\":\"slide__body\",\"allowedBlocks\":[\"core/paragraph\",\"core/list\",\"core/quote\",\"core/heading\",\"core/pullquote\",\"core/table\"]} -->\n<div class=\"wp-block-column slide__body\"><!-- wp:post-title {\"level\":1,\"metadata\":{\"name\":\"Title slide__title\"},\"className\":\"slide__title\"} /-->\n\n<!-- wp:paragraph {\"metadata\":{\"patternName\":\"core/block/1256\",\"name\":\"Paragraph slide__copy\"},\"className\":\"slide__copy\"} -->\n<p class=\"slide__copy\">The Slide pattern supports a figure with image, gallery and video, and body text with title, copy, list, quotes, and links.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"metadata\":{\"name\":\"List slide__list\"},\"className\":\"slide__list\"} -->\n<ul class=\"wp-block-list slide__list\"><!-- wp:list-item -->\n<li>Lorem ipsum dolor sit amet, consectetur.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Integer sed tellus eu odio aliquet semper.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:quote {\"metadata\":{\"name\":\"Quote slide__quote\"},\"className\":\"slide__quote\",\"allowedBlocks\":[\"core/paragraph\",\"core/list\",\"core/verse\"]} -->\n<blockquote class=\"wp-block-quote slide__quote\"><!-- wp:paragraph {\"metadata\":{\"name\":\"Paragraph slide__quote-content\"},\"className\":\"slide__quotation\"} -->\n<p class=\"slide__quotation\">Adding quotes can help you highlight phrases that inspire you — remember to cite.</p>\n<!-- /wp:paragraph --><cite><a href=\"https://wordpress.org/documentation/article/quote-block/\" data-type=\"link\" data-id=\"https://wordpress.org/documentation/article/quote-block/\" rel=\"nofollow\">Citing the Quote Block on WordPress</a></cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph {\"metadata\":{\"name\":\"Paragraph slide__copy\"},\"className\":\"slide__copy\"} -->\n<p class=\"slide__copy\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas tempus feugiat urna, non condime.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"metadata\":{\"name\":\"Paragraph slide__link\"},\"className\":\"slide__link\",\"fontSize\":\"medium\"} -->\n<p class=\"slide__link has-medium-font-size\"><a href=\"https://example.net/\">Lorem ipsum dolor sit amet, consectetur adipiscing elit sit.</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->",
  "syncStatus": "unsynced"
}